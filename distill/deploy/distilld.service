[Unit]
Description=Distill P2P Semantic Q&A Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hungry
Environment=RUST_LOG=info,iroh=warn,tantivy=warn
ExecStart=/home/hungry/.distill/bin/distilld serve
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
